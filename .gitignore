# ── 機密：永不進版控 ────────────────────────────────────────────────
.env
.env.*
!.env.example.txt
*.p12
*.pem
*.key
*.whl
# 玉山 SDK 不在 PyPI ⇒ esun_sdk/ 底下的 whl 進版控（p12 與 config*.ini 仍不進）
!esun_sdk/*.whl
esun_sdk/*.p12
esun_sdk/config*.ini*
backups/*
!backups/.gitkeep
capital.txt

# ── 執行期狀態（持倉／成交／儀表板，bot 產生）────────────────────────
logs/*
!logs/.gitkeep
data/inst_momentum_state.json
data/*.csv

# ── 資料快取（可由程式重建；含第三方資料，不散布）───────────────────
cache/*
results/*
!results/.gitkeep
tmp_gold/
TMP/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 其他 ────────────────────────────────────────────────────────────
.idea/
node_modules/
*:Zone.Identifier
*.bak
*.patch

# LibreOffice 暫存鎖檔
plans/ppt/.~lock.*
plans/ppt/~$*

# 語音流水線產物（可重新產生，不進版控）
plans/ppt/_narration_*/
plans/ppt/*-配音版.pptx
plans/ppt/*.mp4
plans/ppt/*-內容.txt
plans/ppt/*-narration-script.md
plans/ppt/*-pipeline.md
